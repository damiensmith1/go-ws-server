# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional. Overrides REDIS_HOST/REDIS_PORT. Comma-separated; one address is a
# plain client, several form a Cluster client.
REDIS_ADDRS=
# Optional. Set alongside REDIS_ADDRS to use Sentinel failover instead.
REDIS_MASTER_NAME=

# --- WebSocket server ---
WEBSOCKET_PORT=8080
WEBSOCKET_TIMEOUT=300000
MAX_PAYLOAD_BYTES=65536
MAX_BUFFERED_BYTES=1048576

# --- TLS (optional) ---
# Set both to enable wss://. If unset the server runs ws:// (plaintext).
# TLS_KEY_PATH=/path/to/privkey.pem
# TLS_CERT_PATH=/path/to/fullchain.pem

# --- Auth ---
# When AUTH_JWT_SECRET is set, clients must present an HS256 JWT (sub claim
# = userKey) via Authorization: Bearer <token>, or ?token=... query string.
# When unset, the server runs in INSECURE mode (any client can claim any
# userKey via ?userKey=...) and emits a startup warning. Do not deploy
# without setting this.
# AUTH_JWT_SECRET=
# AUTH_JWT_AUDIENCE=
# AUTH_JWT_ISSUER=

# --- Replay history ---
# Per-topic Redis Stream that backs `subscribe` with `since`. MAXLEN is
# applied with the approximate (~) trim, so the actual length may be a
# bit larger. STREAM_TTL_SECONDS, if set, periodically XTRIMs entries
# older than the cutoff.
STREAM_MAX_LENGTH=1000
# STREAM_TTL_SECONDS=

# --- Rate limits ---
RATE_LIMIT_MESSAGES_PER_SEC=50
RATE_LIMIT_JOBS_PER_MIN=30

# --- Scheduler SSRF allow-list ---
# Comma-separated hostnames. If set, the scheduler will only call URLs
# whose hostname matches (or is a subdomain of) one of these. If unset,
# any public hostname is allowed; private/loopback/link-local IPs are
# always blocked.
# SCHEDULER_ALLOWED_HOSTS=api.example.com,hooks.example.com

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info

# Identifies this server instance for distributed scheduler claims.
# Auto-generated if unset.
# INSTANCE_ID=
