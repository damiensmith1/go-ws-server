# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional. Overrides REDIS_HOST/REDIS_PORT. Comma-separated; one address is a
# plain client, several form a Cluster client.
REDIS_ADDRS=
# Optional. Set alongside REDIS_ADDRS to use Sentinel failover instead.
REDIS_MASTER_NAME=

# Comma-separated Origin allowlist for websocket upgrades. Empty keeps the
# same-origin default. Requests with no Origin header (non-browser clients)
# are always allowed. "*" allows every origin — development only.
ALLOWED_ORIGINS=

# Listen address for the Prometheus /metrics endpoint, e.g. ":9090". Empty
# disables it. Deliberately a separate listener from WEBSOCKET_PORT so
# runtime internals are not exposed to websocket clients.
METRICS_ADDR=

# Bounds the Redis ping behind /readyz. Keep it well under the
# orchestrator's own probe timeout so a slow Redis reports "not ready"
# instead of hanging the probe.
READINESS_TIMEOUT_MS=2000

# Per-topic authorization policy, as a JSON object of action -> glob
# patterns. Empty means NO policy: every authenticated client may
# subscribe to, publish to and lock every topic. Set it before serving
# more than one tenant.
#
# Patterns match one dot-separated segment per "*", and "{userKey}" is
# replaced by the caller's identity. An action you leave out denies every
# topic for that action, so this fails closed rather than open.
#
# AUTHZ_RULES={"subscribe":["tenant.{userKey}.*","announcements.*"],"publish":["tenant.{userKey}.*"],"lock":["tenant.{userKey}.*"]}
AUTHZ_RULES=

# Topic receiving connect/disconnect events for the first and last socket
# of each userKey. Empty disables the feed. Publishing user activity to a
# topic others may subscribe to should be a deliberate choice, so this is
# off by default — and if you enable it, cover the topic in AUTHZ_RULES.
PRESENCE_TOPIC=

# Bounds graceful shutdown: draining in-flight HTTP requests and flushing
# queued websocket frames. Keep it below the orchestrator's termination
# grace period, or the process is killed mid-drain and this never applies.
SHUTDOWN_TIMEOUT_MS=10000

# --- WebSocket server ---
WEBSOCKET_PORT=8080
WEBSOCKET_TIMEOUT=300000
MAX_PAYLOAD_BYTES=65536
MAX_BUFFERED_BYTES=1048576

# Evict a connection after this many fan-out messages are dropped back to
# back. 0 disables eviction and restores the old behaviour, where a wedged
# client kept its socket and silently received nothing forever.
#
# Consecutive, not cumulative: any successful send resets the run, so a
# healthy connection that drops the odd frame under a burst is unaffected.
# Evicted clients get close code 1013 and can reconnect with `since` to
# replay what they missed.
MAX_CONSECUTIVE_DROPS=100

# Negotiate permessage-deflate on upgrade. Off by default: it trades CPU
# and per-connection memory for bandwidth, and which side of that trade
# is right depends on your payload shape. Large repetitive JSON benefits;
# small payloads mostly pay the cost. Negotiated per connection, so a
# client that does not offer it is unaffected.
ENABLE_COMPRESSION=false

# --- TLS (optional) ---
# Set both to enable wss://. If unset the server runs ws:// (plaintext).
# TLS_KEY_PATH=/path/to/privkey.pem
# TLS_CERT_PATH=/path/to/fullchain.pem

# --- Auth ---
# When AUTH_JWT_SECRET is set, clients must present an HS256 JWT (sub claim
# = userKey) via Authorization: Bearer <token>, or ?token=... query string.
# When unset, the server runs in INSECURE mode (any client can claim any
# userKey via ?userKey=...) and emits a startup warning. Do not deploy
# without setting this.
# AUTH_JWT_SECRET=
# AUTH_JWT_AUDIENCE=
# AUTH_JWT_ISSUER=

# --- Replay history ---
# Per-topic Redis Stream that backs `subscribe` with `since`. MAXLEN is
# applied with the approximate (~) trim, so the actual length may be a
# bit larger. STREAM_TTL_SECONDS, if set, periodically XTRIMs entries
# older than the cutoff.
STREAM_MAX_LENGTH=1000
# STREAM_TTL_SECONDS=

# Expiry for stored ack cursors. 0 keeps them forever, which leaks a key
# per userKey per topic. It should comfortably exceed your longest
# expected client absence -- a returning client whose cursor has expired
# silently resumes from the top of the stream instead.
ACK_CURSOR_TTL_SECONDS=604800

# --- Rate limits ---
RATE_LIMIT_MESSAGES_PER_SEC=50
RATE_LIMIT_JOBS_PER_MIN=30

# --- Scheduler SSRF allow-list ---
# Comma-separated hostnames. If set, the scheduler will only call URLs
# whose hostname matches (or is a subdomain of) one of these. If unset,
# any public hostname is allowed; private/loopback/link-local IPs are
# always blocked.
# SCHEDULER_ALLOWED_HOSTS=api.example.com,hooks.example.com

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info

# Identifies this server instance for distributed scheduler claims.
# Auto-generated if unset.
# INSTANCE_ID=
